          "type": "string"
        },
        "market_family": {
          "title": "Market Family",
          "type": "string"
        },
        "model_family": {
          "title": "Model Family",
          "type": "string"
        },
        "model_generated_at": {
          "format": "date-time",
          "title": "Model Generated At",
          "type": "string"
        },
        "model_posterior_edge_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Posterior Edge Share"
        },
        "model_probability": {
          "title": "Model Probability",
          "type": "number"
        },
        "model_probability_high": {
          "title": "Model Probability High",
          "type": "number"
        },
        "model_probability_low": {
          "title": "Model Probability Low",
          "type": "number"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "reference_anchored_ev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
