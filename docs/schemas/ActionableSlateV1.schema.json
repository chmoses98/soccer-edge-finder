{
  "$defs": {
    "InputFreshnessV1": {
      "additionalProperties": false,
      "description": "One input's timestamp and freshness. `current_until` / `stale_after` let a reader recompute the state\nat read time (state = CURRENT before current_until, AGING before stale_after, STALE after).",
      "properties": {
        "age_minutes_at_publish": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Minutes At Publish"
        },
        "current_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Until"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "schema_version": {
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stale_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale After"
        },
        "status": {
          "enum": [
            "CURRENT",
            "AGING",
            "STALE",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "InputFreshnessV1",
      "type": "object"
    },
    "ScriptCounterCaseV1": {
      "additionalProperties": false,
      "description": "The strongest opposing MATERIAL script for a contract side at the current price.",
      "properties": {
        "contribution": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "share x conditional edge",
          "title": "Contribution"
        },
        "edge": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(this side | script) - break-even",
          "title": "Edge"
        },
        "p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(this side | script)",
          "title": "P"
        },
        "reason_code": {
          "enum": [
            "SCRIPT_SETTLES_AGAINST",
            "BELOW_BREAKEVEN",
            "NO_MATERIAL_OPPOSITION"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script": {
          "title": "Script",
          "type": "string"
        },
        "share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share"
        },
        "statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement"
        }
      },
      "required": [
        "script",
        "reason_code"
      ],
      "title": "ScriptCounterCaseV1",
      "type": "object"
    },
    "ScriptRobustnessV1": {
      "additionalProperties": false,
      "description": "Script survivability of one contract side at the CURRENT executable price (gamescript/survivability.py).\nComputed by the reprice from cached P(contract | script) - no simulation. Research presentation only: it\nnever changes `action`, authority or the selection policy.",
      "properties": {
        "category": {
          "enum": [
            "ROBUST_ACROSS_SCRIPTS",
            "MIXED",
            "SCRIPT_SPECIFIC_UPSIDE",
            "NO_EDGE"
          ],
          "title": "Category",
          "type": "string"
        },
        "conditional_edges": {
          "description": "per script, in the fixture's `scripts` order",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Conditional Edges",
          "type": "array"
        },
        "counter_case": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptCounterCaseV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decomposition_residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "p_script - model_probability: 0 for analytic families, Monte Carlo error otherwise",
          "title": "Decomposition Residual"
        },
        "edge_concentration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Concentration"
        },
        "edge_ex_top_script": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Ex Top Script"
        },
        "label": {
          "enum": [
            "VERY_ROBUST",
            "ROBUST",
            "MIXED",
            "FRAGILE",
            "SCRIPT_DEPENDENT",
            "NO_EDGE"
          ],
          "title": "Label",
          "type": "string"
        },
        "material_scripts": {
          "default": 0,
          "title": "Material Scripts",
          "type": "integer"
        },
        "neutral_scripts": {
          "default": 0,
          "title": "Neutral Scripts",
          "type": "integer"
        },
        "opposing_scripts": {
          "default": 0,
          "title": "Opposing Scripts",
          "type": "integer"
        },
        "overall_edge": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(side) on the script basis - break-even (= sum of share x conditional edge)",
          "title": "Overall Edge"
        },
        "p_script": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(side) on the exact script basis",
          "title": "P Script"
        },
        "robust_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = best research expression of the fixture (gamescript/expressions.py)",
          "title": "Robust Rank"
        },
        "schema_version": {
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stance": {
          "default": "",
          "description": "one character per script: S supports, O opposes, N neutral, - immaterial",
          "title": "Stance",
          "type": "string"
        },
        "strongest_support": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strongest Support"
        },
        "supporting_scripts": {
          "default": 0,
          "title": "Supporting Scripts",
          "type": "integer"
        },
        "thesis_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "same-thesis group id (research edges only; payoff phi >= 0.5)",
          "title": "Thesis Group"
        },
        "weighted_oppose_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weighted Oppose Share"
        },
        "weighted_support_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weighted Support Share"
        },
        "worst_material_script": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worst Material Script"
        }
      },
      "required": [
        "label",
        "category"
      ],
      "title": "ScriptRobustnessV1",
      "type": "object"
    },
    "SlateComputeV1": {
      "additionalProperties": false,
      "description": "What producing this slate cost. A reprice-only slate has simulations=0 and odds_api_calls=0.",
      "properties": {
        "fixtures_resimulated": {
          "items": {
            "type": "string"
          },
          "title": "Fixtures Resimulated",
          "type": "array"
        },
        "fixtures_reused_from_cache": {
          "items": {
            "type": "string"
          },
          "title": "Fixtures Reused From Cache",
          "type": "array"
        },
        "kalshi_capture_runtime_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kalshi Capture Runtime S"
        },
        "mode": {
          "enum": [
            "reprice_only",
            "model_refresh_and_reprice"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model_refresh_runtime_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Refresh Runtime S"
        },
        "odds_api_calls": {
          "default": 0,
          "title": "Odds Api Calls",
          "type": "integer"
        },
        "odds_api_credits": {
          "default": 0,
          "title": "Odds Api Credits",
          "type": "integer"
        },
        "reprice_runtime_s": {
          "title": "Reprice Runtime S",
          "type": "number"
        },
        "schema_version": {
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "simulations_run": {
          "default": 0,
          "title": "Simulations Run",
          "type": "integer"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "trigger",
        "reprice_runtime_s"
      ],
      "title": "SlateComputeV1",
      "type": "object"
    },
    "SlateContractV1": {
      "additionalProperties": false,
      "description": "One contract side. Prices are dollar strings; probabilities floats in [0, 1] for THIS side.",
      "properties": {
        "action": {
          "enum": [
            "ACTIONABLE",
            "RESEARCH_CANDIDATE",
            "NO_EDGE",
            "STALE_PRICE",
            "NO_QUOTE",
            "MODEL_INVALIDATED",
            "MODEL_STALE",
            "FEE_UNVERIFIED",
            "EXCLUDED_BY_GATE"
          ],
          "title": "Action",
          "type": "string"
        },
        "action_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Action Reasons",
          "type": "array"
        },
        "action_valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "after this instant the price is no longer CURRENT: re-read",
          "title": "Action Valid Until"
        },
        "authority": {
          "enum": [
            "RESEARCH_ONLY",
            "SHADOW",
            "LIMITED",
            "TRUSTED"
          ],
          "title": "Authority",
          "type": "string"
        },
        "available_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Size"
        },
        "best_expression": {
          "default": false,
          "title": "Best Expression",
          "type": "boolean"
        },
        "bet_permitted": {
          "default": false,
          "title": "Bet Permitted",
          "type": "boolean"
        },
        "bet_up_to_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bet Up To Price"
        },
        "breakeven_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "executable price + fee per contract (probability units)",
          "title": "Breakeven Price"
        },
        "competition": {
          "title": "Competition",
          "type": "string"
        },
        "context_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Observed At"
        },
        "event_name": {
          "title": "Event Name",
          "type": "string"
        },
        "event_ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Ticker"
        },
        "fee_adjusted_ev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "model probability - break-even (per $1 contract)",
          "title": "Fee Adjusted Ev"
        },
        "fee_per_contract": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Per Contract"
        },
        "fixture_id": {
          "title": "Fixture Id",
          "type": "string"
        },
        "freshness": {
          "additionalProperties": {
            "enum": [
              "CURRENT",
              "AGING",
              "STALE",
              "UNAVAILABLE"
            ],
            "type": "string"
          },
          "description": "model / kalshi / reference / lineup / context state at publish",
          "title": "Freshness",
          "type": "object"
        },
        "kalshi_no_ask": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kalshi No Ask"
        },
        "kalshi_no_bid": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kalshi No Bid"
        },
        "kalshi_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kalshi Observed At"
        },
        "kalshi_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "executable ask for this side (never a midpoint)",
          "title": "Kalshi Price"
        },
        "kalshi_yes_ask": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
