    "SlateFixtureScriptsV1": {
      "additionalProperties": false,
      "description": "Fixture-level script summary at this slate's prices. Shares are model (market-blind) values copied from\nthe board; edge lists depend on the current price. Keys are 'ticker|side'.",
      "properties": {
        "best_robust_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Robust Expression"
        },
        "best_script_specific_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Script Specific Expression"
        },
        "material": {
          "items": {
            "type": "string"
          },
          "title": "Material",
          "type": "array"
        },
        "mixed_edges": {
          "items": {
            "type": "string"
          },
          "title": "Mixed Edges",
          "type": "array"
        },
        "no_compelling_edge": {
          "default": true,
          "title": "No Compelling Edge",
