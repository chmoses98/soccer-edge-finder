# soccer-edge-finder uses only PUBLIC Kalshi endpoints for discovery/capture.
# No Kalshi credentials are required for anything in this repository.
# Nothing here should ever hold account keys; automated trading is not implemented.

# Optional: override the Kalshi public API base (default is the production public host).
# SOCCER_EDGE_KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Optional: local cache directory for provider downloads (default: data/cache).
# SOCCER_EDGE_CACHE_DIR=data/cache

# Optional: football-data.org free-tier token (fixture/lineup provider, 10 req/min). Not required.
# FOOTBALL_DATA_ORG_TOKEN=

# Optional: The Odds API key — the SAME key/secret name already used by chmoses98/edge-finder-api (the
# account is shared; do not create another). Enables the budget-guarded Pinnacle reference capture
# (docs/ODDS_API_REFERENCE.md). In CI it is the repository secret ODDS_API_KEY. Never commit a value.
# ODDS_API_KEY=
